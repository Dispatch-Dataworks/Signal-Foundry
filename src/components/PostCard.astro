---
import type { Post } from '../lib/schema';
interface Props {
  post: Post;
  number?: number;
}
const { post, number } = Astro.props;
const displayDate = new Date(`${post.published}T00:00:00Z`).toLocaleDateString(
  'en-US',
  { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' },
);
---

<article class="post-card">
  <div class="post-top">
    <time datetime={post.published}>{displayDate}</time>
    {number !== undefined && (
      <span aria-hidden="true">{String(number + 1).padStart(2, '0')}</span>
    )}
  </div>
  <h3>
    <a href={`/devlog/${post.slug}/`}>{post.title}</a>
  </h3>
  <p>{post.excerpt}</p>
  <div class="post-bottom">
    <span>{post.tags.slice(0, 2).join(' / ') || 'Field notes'}</span>
    <a href={`/devlog/${post.slug}/`} aria-label={`Read ${post.title}`}>
      Read entry <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
