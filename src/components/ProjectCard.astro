---
import type { Project } from '../lib/schema';
import MediaImage from './MediaImage.astro';
import { projectImage } from './media';
interface Props {
  project: Project;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const image = projectImage(project, true);
---

<article class:list={['project-card', { compact }]}>
  <a
    class="card-art"
    href={`/projects/${project.slug}/`}
    tabindex="-1"
    aria-hidden="true"
  >
    <MediaImage
      src={image?.src ?? ''}
      alt=""
      width={960}
      height={600}
      sizes="(max-width: 580px) calc(100vw - 40px), (max-width: 820px) calc((100vw - 82px) / 2), 440px"
      loading="lazy"
    />
    <span class="art-index">
      {project.collection === 'games' ? 'PLAY / EXPLORE' : 'BUILD / EXPERIMENT'}
    </span>
  </a>
  <div class="card-body">
    <div class="card-meta">
      <span
        class:list={['status', { archived: project.status === 'Archived' }]}
      >
        {project.status}
      </span>
      {project.developmentState && <span>{project.developmentState}</span>}
    </div>
    <h3>
      <a href={`/projects/${project.slug}/`}>
        {project.title}
        <span aria-hidden="true">↗</span>
      </a>
    </h3>
    <p>{project.excerpt}</p>
    <div class="card-bottom">
      <span>
        {project.platforms.length
          ? project.platforms.join(' / ')
          : 'Platform to be determined'}
      </span>
      <span class="card-link" aria-hidden="true">
        Project notes →
      </span>
    </div>
  </div>
</article>
