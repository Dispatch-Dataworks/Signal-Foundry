---
interface Props { small?: boolean }
const { small = false } = Astro.props;
---
<div class:list={['signal-art', { 'signal-art-small': small }]} aria-hidden="true">
  <svg viewBox="0 0 640 520" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="signal-gradient" x1="70" y1="250" x2="570" y2="250" gradientUnits="userSpaceOnUse"><stop stop-color="#83f5e7" stop-opacity=".15"/><stop offset=".5" stop-color="#83f5e7"/><stop offset="1" stop-color="#83f5e7" stop-opacity=".15"/></linearGradient>
      <pattern id="signal-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" stroke="#73b1ae" stroke-opacity=".13"/></pattern>
    </defs>
    <rect x="40" y="40" width="560" height="440" fill="url(#signal-grid)" />
    <circle cx="320" cy="260" r="176" stroke="#83f5e7" stroke-opacity=".12"/>
    <circle cx="320" cy="260" r="130" stroke="#83f5e7" stroke-opacity=".22" stroke-dasharray="3 12"/>
    <path d="M40 260H600M320 40V480" stroke="#83f5e7" stroke-opacity=".17"/>
    <g stroke="url(#signal-gradient)" stroke-width="6" stroke-linecap="round">
      <path d="M80 248V272M100 239V281M120 245V275M140 225V295M160 205V315M180 232V288M200 182V338M220 209V311M240 160V360M260 122V398M280 169V351M300 106V414M320 139V381M340 91V429M360 150V370M380 183V337M400 137V383M420 205V315M440 194V326M460 224V296M480 214V306M500 237V283M520 230V290M540 245V275M560 250V270"/>
    </g>
    <g fill="#83f5e7"><circle cx="144" cy="260" r="4"/><circle cx="496" cy="260" r="4"/><path d="M36 40H52M44 32V48M588 480H604M596 472V488"/></g>
  </svg>
  <span class="signal-label label-top">SF / SIGNAL GENERATOR</span>
  <span class="signal-label label-bottom">IDEAS IN. EXPERIENCES OUT.</span>
  <span class="signal-coordinate">01 — ∞</span>
</div>
