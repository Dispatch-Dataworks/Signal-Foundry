{
  "name": "signal-foundry",
  "version": "1.0.0",
  "description": "The static home of Signal Foundry Games",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . && astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "astro sync && node --experimental-strip-types scripts/validate-content.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:links": "node --experimental-strip-types scripts/check-output.mjs",
    "check": "npm run lint && npm run format:check && npm run validate && npm test && npm run build && npm run check:links"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "astro": "^7.3.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "yaml": "^2.9.1"
  }
}
